# Copy to .env (git-ignored) and fill in. Environment variables already set in your shell take precedence.

# Required for generated answers. Without it the app still runs in retrieval-only mode.
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4.1-mini
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_SECONDS=30
# EMBEDDING_MODEL=all-MiniLM-L6-v2   # must match the model used to build embeddings/embeddings.npy
# TOP_K=5
# MIN_SIMILARITY=0.30                # below this cosine similarity, the assistant declines to answer
